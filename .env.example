# Copia este archivo con el nombre .env y cambia cada PON_AQUI_... por el valor real.
# El archivo .env NUNCA se sube a GitHub.

# Cadena de conexión de MongoDB Atlas.
# Cambia SOLO la palabra CONTRASEÑA por la contraseña del usuario coopentaxilosjardines_db_user
# (sin < > y sin espacios).
MONGODB_URI=mongodb+srv://coopentaxilosjardines_db_user:CONTRASEÑA@cluster0.wcsyt4f.mongodb.net/

# Clave para entrar al Panel de administración. Invéntala tú (larga, 12+ caracteres).
ADMIN_PASSWORD=PON_AQUI_LA_CLAVE_DEL_PANEL

# Texto secreto largo para las sesiones. Escribe cualquier texto largo inventado (30+ caracteres).
JWT_SECRET=PON_AQUI_UN_TEXTO_SECRETO_LARGO

# Puerto para probar en la computadora.
PORT=3000
